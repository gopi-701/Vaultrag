{
  "name": "vaultrag",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "data:generate": "tsx scripts/generate-synthetic-data.ts",
    "documents:prepare": "tsx scripts/prepare-documents.ts",
    "eval": "npm run eval:validate",
    "eval:validate": "node --conditions=react-server --import tsx scripts/run-evals.ts --validate-only",
    "eval:live": "node --conditions=react-server --import tsx scripts/run-evals.ts",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:ingest": "tsx scripts/ingest.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.30",
    "@qdrant/js-client-rest": "^1.19.0",
    "ai": "^7.0.77",
    "cohere-ai": "^8.0.1",
    "jsonwebtoken": "^9.0.3",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
